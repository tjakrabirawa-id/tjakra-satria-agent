[Unit]
# systemd unit template for the tjakra-satria patrol agent.
# install.sh substitutes the __PLACEHOLDER__ tokens and writes the result to
# /etc/systemd/system/tjakra-satria-agent.service. You can also copy this file by
# hand and replace the tokens yourself.
#
# Substituted tokens:
#   __BINARY__      absolute path to the agent binary, e.g. /usr/local/bin/tjakra-satria-agent
#   __CONFIG__      absolute path to the enrolled config, e.g. /etc/tjakra-satria-agent/agent.json
#   __EXEC_FLAGS__  the run flags, e.g. -log-file /var/log/app/access.log -enforce -console -poll 5s
Description=tjakra-satria patrol agent (Defence and Response)
Documentation=https://github.com/tjakrabirawa-id/tjakra-satria-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__BINARY__ run -config __CONFIG__ __EXEC_FLAGS__
Restart=always
RestartSec=5

# User selection and the enforce tradeoff.
# Default is root. The agent needs NET_ADMIN to change iptables for block_ip and
# revert_block, and root to run usermod -L for disable_user. Running as root
# covers both. If you do not use -enforce, or you never expect disable_user, you
# can run as a dedicated non-login system user with only CAP_NET_ADMIN instead.
User=root
Group=root

# Hardened non-root alternative (comment out User=root and Group=root above,
# then uncomment these). CAP_NET_ADMIN lets iptables work without full root, but
# usermod -L for disable_user still needs root, so disable_user will fail under
# this profile. Create the user first, for example:
#   useradd --system --no-create-home --shell /usr/sbin/nologin tjakra-satria-agent
#   chown -R tjakra-satria-agent:tjakra-satria-agent /etc/tjakra-satria-agent
# User=tjakra-satria-agent
# Group=tjakra-satria-agent
# AmbientCapabilities=CAP_NET_ADMIN
# CapabilityBoundingSet=CAP_NET_ADMIN

# Conservative hardening that does not break enforce. Uncomment as suits the host.
# NoNewPrivileges=true
# ProtectHome=true
# ProtectSystem=full
# ReadWritePaths=/etc/tjakra-satria-agent

[Install]
WantedBy=multi-user.target
